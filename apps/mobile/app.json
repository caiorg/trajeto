{
  "expo": {
    "name": "Trajeto",
    "slug": "trajeto",
    "scheme": "trajeto",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.trajeto.app"
    },
    "android": {
      "package": "dev.trajeto.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Trajeto usa sua localização para navegar e aprender seus trajetos frequentes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
