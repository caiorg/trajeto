{
  "name": "trajeto",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun run --filter @trajeto/core test",
    "typecheck": "bun run --filter \"*\" typecheck",
    "api": "bun run --cwd apps/api dev",
    "web": "bun run --cwd apps/mobile web",
    "seed": "bun run --cwd apps/api seed"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiorg/trajeto.git"
  },
  "packageManager": "bun@1.3.6"
}
